{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tig read-only agent query experimental-1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "enrollment", "query"],
  "properties": {
    "schema": {"const": "tig.query.experimental-1"},
    "enrollment": {"type": "string", "description": "Absolute machine-local catalogue enrollment path."},
    "offset": {"type": "integer", "minimum": 0, "maximum": 1000000, "default": 0},
    "expected_basis": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$", "description": "Use the prior basis_sha256 to refuse changed commits, captured metadata, display rules, collections or graph admission while paging."},
    "expected_snapshots": {"type": "object", "maxProperties": 32, "additionalProperties": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"}, "description": "When supplied, must exactly match all queried project IDs and commits; copy from the prior result basis when paging."},
    "query": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["operation"], "properties": {"operation": {"const": "projects"}}},
      {"type":"object","additionalProperties":false,"required":["operation","project"],"properties":{"operation":{"const":"works"},"project":{"type":"string","not":{"const":"all"}},"collection":{"type":"string","maxLength":80},"text":{"type":"string","maxLength":256},"state":{"type":"string","maxLength":120},"facet":{"type":"string","maxLength":120}}},
      {"type":"object","additionalProperties":false,"required":["operation","project","collection","work","sha256"],"properties":{"operation":{"const":"manifest_references"},"project":{"type":"string","not":{"const":"all"}},"collection":{"type":"string","minLength":1,"maxLength":80},"work":{"type":"string","minLength":1,"maxLength":256},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"expected_content":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"}}},
      {"type":"object","additionalProperties":false,"required":["operation","project","asset"],"properties":{"operation":{"const":"inspect"},"project":{"type":"string","not":{"const":"all"}},"asset":{"type":"string","minLength":1,"maxLength":256}}},
      {"type":"object","additionalProperties":false,"required":["operation","project","kinds"],"properties":{"operation":{"const":"admission"},"project":{"type":"string"},"definition":{"type":"string","maxLength":256},"kinds":{"type":"array","minItems":1,"maxItems":5,"uniqueItems":true,"items":{"enum":["production","composition","publication","evidence","authority"]}}}},
      {"type":"object","additionalProperties":false,"required":["operation","project","asset","kinds","profiles"],"properties":{"operation":{"const":"preview_admission"},"project":{"type":"string","not":{"const":"all"}},"asset":{"type":"string","minLength":1,"maxLength":256},"kinds":{"$ref":"#/$defs/kinds"},"profiles":{"type":"array","maxItems":128,"items":{"$ref":"#/$defs/profile"}}}},
      {"type": "object", "additionalProperties": false, "required": ["operation", "project", "text"], "properties": {"operation": {"const": "find"}, "project": {"type": "string"}, "text": {"type": "string", "maxLength": 256}, "category": {"type": "string", "maxLength": 256}}},
      {"type": "object", "additionalProperties": false, "required": ["operation", "left", "right"], "properties": {"operation": {"const": "shared"}, "left": {"type": "string"}, "right": {"type": "string"}, "category": {"type": "string", "maxLength": 256}}},
      {"type": "object", "additionalProperties": false, "required": ["operation", "project", "sha256"], "properties": {"operation": {"const": "references"}, "project": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
      {"type": "object", "additionalProperties": false, "required": ["operation", "left", "right"], "properties": {"operation": {"const": "compare"}, "left": {"$ref": "#/$defs/asset"}, "right": {"$ref": "#/$defs/asset"}}},
      {"type": "object", "additionalProperties": false, "required": ["operation", "project", "asset", "kinds"], "properties": {"operation": {"enum": ["impact", "where_used"]}, "project": {"type": "string", "description": "One explicit project; cross-project semantic edges are not inferred."}, "asset": {"type": "string", "minLength": 1, "maxLength": 256}, "kinds": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"enum": ["production", "composition", "publication", "evidence", "authority"]}}}}
    ]}
  },
  "allOf":[
    {"if":{"properties":{"query":{"properties":{"operation":{"enum":["preview_admission","manifest_references"]}}}}},"then":{"required":["expected_basis"],"properties":{"expected_basis":{"type":"string"}}}},
    {"if":{"required":["offset"],"properties":{"offset":{"minimum":1},"query":{"properties":{"operation":{"const":"manifest_references"}}}}},"then":{"properties":{"query":{"required":["expected_content"],"properties":{"expected_content":{"type":"string"}}}}}}
  ],
  "$defs": {
    "asset": {"type": "object", "additionalProperties": false, "required": ["project", "id"], "properties": {"project": {"type": "string"}, "id": {"type": "string", "minLength": 1, "maxLength": 256}}},
    "object":{"type":"object","additionalProperties":false,"required":["sha256","bytes"],"properties":{"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"bytes":{"type":"integer","minimum":0,"maximum":65536}}},
    "kinds":{"type":"array","minItems":1,"maxItems":5,"uniqueItems":true,"items":{"enum":["production","composition","publication","evidence","authority"]}},
    "tokens":{"type":"array","minItems":1,"maxItems":128,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":128}},
    "rule":{"type":"object","additionalProperties":false,"required":["pointer","kind","collection","optional","binding"],"properties":{"pointer":{"type":"string","maxLength":256},"kind":{"enum":["production","composition","publication","evidence","authority"]},"collection":{"enum":["one","array","object_values"]},"optional":{"type":"boolean"},"binding":{"enum":["ExactOnly","SnapshotSelected","Either"]}}},
    "payloads":{"oneOf":[{"enum":["None","SelectedObject","Unsupported"]},{"type":"object","additionalProperties":false,"required":["Streams"],"properties":{"Streams":{"type":"object","additionalProperties":false,"required":["roles","groups","min"],"properties":{"roles":{"$ref":"#/$defs/tokens"},"groups":{"$ref":"#/$defs/tokens"},"min":{"type":"integer","minimum":0,"maximum":256}}}}},{"type":"object","additionalProperties":false,"required":["Named"],"properties":{"Named":{"type":"object","additionalProperties":false,"required":["selected","slots"],"properties":{"selected":{"type":"boolean"},"slots":{"type":"array","maxItems":256,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":128}}}}}}]},
    "profile":{"type":"object","additionalProperties":false,"required":["definition_id","definition","class","covered","rules","payloads"],"properties":{"definition_id":{"type":"string","minLength":1,"maxLength":256},"definition":{"$ref":"#/$defs/object"},"class":{"enum":["primary","output","container"]},"covered":{"type":"array","maxItems":5,"uniqueItems":true,"items":{"enum":["production","composition","publication","evidence","authority"]}},"rules":{"type":"array","maxItems":128,"items":{"$ref":"#/$defs/rule"}},"payloads":{"$ref":"#/$defs/payloads"}}}
  }
}
