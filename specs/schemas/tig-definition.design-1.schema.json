{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tig:definition:design-1",
  "title": "Tig type definition design fixture; not released runtime format",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "authored_schema", "authoring", "stream_rules", "semantic_rules"],
  "properties": {
    "schema": {"const": "tig.definition.design-1"},
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "authored_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "bytes"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
      }
    },
    "authoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["properties", "required", "defaults"],
      "properties": {
        "properties": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "required": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "defaults": {"type": "object"}
      }
    },
    "stream_rules": {"type": "object"},
    "semantic_rules": {"type": "object"}
  }
}
