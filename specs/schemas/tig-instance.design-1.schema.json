{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tig:instance:design-1",
  "title": "Tig instance design fixture envelope; not released runtime format",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "definition", "authored", "streams", "selected", "status", "metadata"],
  "properties": {
    "schema": {"const": "tig.instance.design-1"},
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "definition": {
      "allOf": [{"$ref": "#/$defs/pin"}],
      "required": ["id"]
    },
    "authored": {"type": "object"},
    "streams": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot", "role", "group", "object"],
        "properties": {
          "slot": {"type": "string", "minLength": 1, "maxLength": 128},
          "role": {"type": "string", "minLength": 1, "maxLength": 128},
          "group": {"type": "string", "minLength": 1, "maxLength": 128},
          "object": {"$ref": "#/$defs/pin"},
          "provenance": {"type": "object"}
        }
      }
    },
    "selected": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/pin"}]},
    "status": {"type": "object"},
    "metadata": {"type": "object"}
  },
  "$defs": {
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "bytes"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 256},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "media_type": {"type": "string", "maxLength": 128}
      }
    }
  }
}
