  "counterexamples": [
    {
      "id": "same-byte-rename",
      "assertion": "Rename changes authored bindings but no object identity or required physical copies."
    },
    {
      "id": "backup-unavailable",
      "assertion": "A merge may be accepted while placement is pending; unavailable custody cannot authorize eviction."
    },
    {
      "id": "late-claim",
      "assertion": "A new branch or job before removal holds the object and invalidates stale destructive consent."
    },
    {
      "id": "interrupt-and-retry",
      "assertion": "Resume the exact admitted operation; report historical effects without repeating loss."
    },
    {
      "id": "cancel",
      "assertion": "A durable stop prevents further deletion; completed loss is preserved and unknown cleanup stays unknown."
    },
    {
      "id": "same-hash-new-birth",
      "assertion": "An old deletion outcome cannot remove a separately authorized later acquisition."
    },
    {
      "id": "metadata-expiry",
      "assertion": "Detailed records can expire only after surviving authority/replay fences and dependencies are resolved; this lesson remains gated."
    }
  ],
  "evidence_required_per_stage": [
    "exact_source_snapshot",
